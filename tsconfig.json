{
	"compilerOptions": {
		"target": "ESNext",
		"jsx": "preserve",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"components/**/*.vue",
		"layouts/**/*.vue",
		"*.vue",
		"**/*.ts",
		"*.d.ts"
	],
	"exclude": ["node_modules", "dist"]
}
